/target
__pycache__
*.pyc
*.so
*.egg-info
.venv
dist/

# Large binary files (models, training data, logs)
models/
data/
logs/
*.bin
!python/colver/web/static/wasm/*.bin
*.pt

# SVG card source archives
images/SVG-cards-1.3.zip

# Personal photos
images/real_hands/

# WSL Zone.Identifier files
*:Zone.Identifier

# Secrets
# `*.env` et pas seulement `.env` : les fichiers de secrets arrivent souvent
# nommés par leur usage (smtp.env, deploy.env…), et le dépôt est public.
.env
*.env

# Private strategy documents
docs/enchere_cannes_roro.md

# Playwright MCP
.playwright-mcp/

# Screenshots (keep images/cards SVGs)
*.png
!images/**/*.png
!python/colver/web/static/favicon-32.png
!python/colver/web/static/apple-touch-icon.png

# Training logs and eval outputs
*.log
retro_evals.txt

# Tournament results
results/
.claude/

# Sauvegardes de la base web (bind mount docker-compose)
backups/
